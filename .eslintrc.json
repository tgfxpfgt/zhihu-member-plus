{
  "root": true,
  "env": {
    "browser": true,
    "webextensions": true,
    "es2022": true
  },
  "globals": {
    "chrome": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": "warn",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-undef": "error",
    "no-redeclare": "warn"
  }
}
